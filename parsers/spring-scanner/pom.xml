<?xml version="1.0" encoding="UTF-8"?>
<!--
  APIForge 的 Spring Boot 扫描器，PRD v0.3 模块 4.1 / 技术方案 §2.1。

  独立进程跑（java -jar），不入出句前端构建。目标 Java 8：用户机器上
  常见的是 JDK 8（出句开发者环境调研），不要用更新的语法。打出来的是
  shade fat jar，JavaParser 打进去，用户机器只需要一个 JRE。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.chuju.apiforge</groupId>
  <artifactId>spring-scanner</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 3.26.4 实测 class 版本仍是 52（Java 8 运行时可跑），LanguageLevel 到 JAVA_21；
         3.25.x 默认语言级别太老，Java 17 的 record 整文件解析失败（controller 直接丢）。
         core 无第三方依赖，shade 后单文件可用 -->
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
      <version>3.26.4</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>spring-scanner</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.chuju.apiforge.Scanner</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
